# ==============================================================================
# Skillware-Bench Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the repository root and fill in your keys.
# Never commit `.env` containing live secrets or private keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontier LLM Provider Credentials (Required for Live Model Evaluation)
# ------------------------------------------------------------------------------
# OpenRouter API (Universal Provider for Frontier, Sovereign & Free Models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API="sk-or-v1-..."
OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free" # or deepseek/deepseek-v4-pro, google/gemini-4-argon, etc.

# Google Gemini (Google GenAI SDK)
GOOGLE_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.8-flash" # or gemini-3.8-pro, gemini-2.5-pro, gemini-2.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5" # or claude-3-7-sonnet-20250219, claude-3-5-haiku-20241022

# OpenAI
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-5" # or gpt-4o, gpt-4o-mini, o3-mini

# Mistral AI
MISTRAL_API_KEY="your_mistral_api_key_here"
MISTRAL_MODEL="mistral-large-3" # or mistral-large-latest, codestral-latest

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat" # or deepseek-reasoner

# Groq (Llama / Open Source Fast Inference)
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"

# Local Ollama Runtime (Offline / Sovereign Model Evaluation)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest" # or mistral:latest, qwen2.5:latest

# ------------------------------------------------------------------------------
# 2. Live Skill Integrations (For Real-World Simulation & Stress Tests)
# ------------------------------------------------------------------------------
# UK Companies House API (finance/uk_companies_house_handler)
# Get key: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY="your_companies_house_api_key_here"

# Crypto Wallet Screening (finance/wallet_screening)
# Etherscan API: https://etherscan.io/apis
ETHERSCAN_API_KEY="your_etherscan_api_key_here"
COINGECKO_API_KEY="optional_coingecko_key_here"

# Dedicated Agent Mailbox (office/gmail_handler)
# IMPORTANT: Use a fresh, dedicated agent-only Gmail account with App Password.
# Never configure your personal or primary inbox!
GMAIL_ADDRESS="agent-mailbox@example.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# GitHub Token (dev_tools/issue_resolver)
GITHUB_TOKEN="github_pat_..."

# ------------------------------------------------------------------------------
# 3. Benchmark Harness Runtime Settings
# ------------------------------------------------------------------------------
# Set to 'true' to run fully offline using recorded fixtures and mock transports
SKILLWARE_BENCH_MOCK="true"

# Output directory for evaluation reports, raw trajectories, and chart artifacts
SKILLWARE_BENCH_OUTPUT_DIR="./runs/reports"

# Benchmark concurrency and timeout
SKILLWARE_BENCH_TIMEOUT_SECONDS="60"
SKILLWARE_BENCH_MAX_RETRIES="2"
SKILLWARE_BENCH_VERBOSE="true"
